;; RFC-A MVP A2: product-only op on entangled qubit must fail compile once χ exists.
;; TODAY: entanglement-indexed types are NOT implemented — this test documents the target.
;; EXPECT-MODE: strict-types
;; EXPECT-COMPILE: fail
;; EXPECT-STDERR: entanglement
;; EXPECT-STDERR: χ
;;
;; When Qubit[χ≤k] lands, Bell-prep should raise χ and @product-only must reject.
;; Until then the compiler will not emit those stderr tokens → harness treats as fail (red).

(define (bell)
  ;; Sketch of future typed API — not executable on today's quantum.esk handles.
  (let* ((q0 : Qubit (alloc-qubit))
         (q1 : Qubit (alloc-qubit))
         (q0h : Qubit (h q0))
         (pair (cnot q0h q1)))
    pair))

(define (bad-product-only)
  (let ((pair (bell)))
    ;; @product-only claims separability; RFC-A requires reject when χ>1
    (product-only-local (car pair))))
