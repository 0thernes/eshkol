;; RFC-C MVP C1: leaking an ancilla inside with-uncompute must fail compile.
;; EXPECT-MODE: strict-types
;; EXPECT-COMPILE: fail
;; EXPECT-STDERR: uncompute
;; EXPECT-STDERR: ancilla
;; RFC-C-STATUS: red until with-uncompute is real — may fail for wrong reason today.

(define (leaky)
  (with-uncompute ((a : Qubit (alloc-qubit)))
    ;; use ancilla but never uncompute / return to |0>
    (h a)
    42))
